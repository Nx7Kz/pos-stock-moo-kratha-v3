# --- Auth ---
JWT_SECRET=change_me
JWT_EXPIRES_IN=12h

# --- CORS ---
CORS_ORIGIN=http://localhost:5173

# --- สำรองข้อมูล (npm run db:backup) ---
# โฟลเดอร์เก็บไฟล์สำรอง (ค่าเริ่มต้น backend/backups) แนะนำชี้ไปโฟลเดอร์ OneDrive/Google Drive
# BACKUP_DIR=C:/Users/<ชื่อ>/OneDrive/pos-backups
# จำนวนชุดที่เก็บย้อนหลัง
# BACKUP_KEEP=30
