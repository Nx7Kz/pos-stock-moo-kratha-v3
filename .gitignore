# ---------------------------------------------------------------- dependencies
node_modules/

# --------------------------------------------------------------------- ผลลัพธ์ build
dist/
build/

# ------------------------------------------------------- ความลับ ห้ามขึ้น git
# ไฟล์นี้มีรหัสผ่านฐานข้อมูลและ JWT secret — ใช้ .env.example เป็นแม่แบบแทน
.env
.env.local
*.env
!.env.example

# ------------------------------------------------------------------------- log
*.log
npm-debug.log*
logs/

# --------------------------------------------------------- ไฟล์เฉพาะเครื่อง
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# ------------------------------------------------------------- เครื่องมือภายใน
.claude/

# ------------------------------------------ ไฟล์สำรองฐานข้อมูล (npm run db:backup)
# มีข้อมูลการขายและรหัสผ่านผู้ใช้ (เข้ารหัสแล้ว) repo เป็น public ห้ามขึ้น git
backend/backups/

# ------------------------------------------------ SonarQube (โฟลเดอร์ sonar/)
# รายงาน HTML ที่ใช้สร้าง PDF (PDF เก็บขึ้น git ได้ ไว้ส่งอาจารย์/ทีม)
sonar/reports/*.html
__pycache__/
